---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** An imported image, e.g. `import shot from "../../assets/shot.png"`.
	    It must be imported rather than a /public path, because only images
	    Astro can see at build time get resized. */
	src: ImageMetadata;
	alt: string;
	/** Width of the inline thumbnail that Astro generates. The zoomed view
	    always shows the original at full resolution. */
	width?: number;
	/** When given, the image is wrapped in a figure with this caption. */
	caption?: string;
}

const { src, alt, width = 720, caption } = Astro.props;

// Each instance needs its own id so several zoomable images can share a page.
const id = `zoom-${crypto.randomUUID()}`;
---

{
	caption ? (
		<figure class="zoom-figure">
			<button type="button" class="zoom-thumb" popovertarget={id} aria-label={`Enlarge: ${alt}`}>
				<Image src={src} alt={alt} width={width} loading="lazy" />
			</button>
			<figcaption>{caption}</figcaption>
		</figure>
	) : (
		<button type="button" class="zoom-thumb" popovertarget={id} aria-label={`Enlarge: ${alt}`}>
			<Image src={src} alt={alt} width={width} loading="lazy" />
		</button>
	)
}

<div id={id} popover class="zoom-overlay">
	<img src={src.src} width={src.width} height={src.height} alt={alt} />
</div>

<style>
	.zoom-figure {
		margin: 1.5rem 0;
	}
	.zoom-figure figcaption {
		margin-top: 0.4rem;
		font-size: 0.9rem;
		color: var(--muted, #666);
		text-align: center;
	}

	/* The thumbnail is a button so it is keyboard focusable and announces
	   itself, but it should look like a plain image. */
	.zoom-thumb {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}
	.zoom-thumb img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}
	.zoom-thumb:focus-visible {
		outline: 2px solid var(--link, #0b5fff);
		outline-offset: 3px;
	}

	/* popover puts this in the browser's top layer, so it needs no z-index and
	   closes on Esc or an outside click without any JavaScript. */
	.zoom-overlay {
		max-width: 96vw;
		max-height: 96vh;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		overflow: auto;
		background: #fff;
		cursor: zoom-out;
	}
	.zoom-overlay::backdrop {
		background: rgb(0 0 0 / 0.8);
	}
	/* Shown at natural size, not scaled to fit: the point of zooming is to read
	   small type, so overflow scrolls rather than shrinking the image again. */
	.zoom-overlay img {
		display: block;
		max-width: none;
	}
</style>
