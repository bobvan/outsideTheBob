---
import { tagSlug, tagLinks } from '../tags';

interface Props {
	tags?: string[];
}

const { tags } = Astro.props;

// Shared with the tags index, so a one-post tag points at that post from
// everywhere rather than only from the index.
const links = await tagLinks();

const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const here = withSlash(Astro.url.pathname);

// A single-post tag resolves to that post, which on the post itself is the page
// you are already reading. Render those as plain text rather than a link that
// goes nowhere.
const destination = (tag: string) => {
	const href = links.get(tagSlug(tag)) ?? `/tags/${tagSlug(tag)}/`;
	return withSlash(href) === here ? null : href;
};
---

{
	tags && tags.length > 0 && (
		<span class="tag-list">
			{' • '}
			{tags.map((tag, i) => (
				<>
					{i > 0 && ', '}
					{destination(tag) ? <a href={destination(tag)}>{tag}</a> : <span>{tag}</span>}
				</>
			))}
		</span>
	)
}

<style>
	/* Inherit the muted colour of the surrounding post meta rather than the link
	   blue, so a row of tags stays subordinate to the post title. */
	.tag-list a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px dotted currentColor;
	}
	.tag-list a:hover {
		color: var(--link);
		border-bottom-color: var(--link);
	}
</style>
