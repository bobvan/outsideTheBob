---
import { tagSlug } from '../tags';

interface Props {
	tags?: string[];
}

const { tags } = Astro.props;
---

{
	tags && tags.length > 0 && (
		<span class="tag-list">
			{' • '}
			{tags.map((tag, i) => (
				<>
					{i > 0 && ', '}
					<a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
				</>
			))}
		</span>
	)
}

<style>
	/* Inherit the muted colour of the surrounding post meta rather than the link
	   blue, so a row of tags stays subordinate to the post title. */
	.tag-list a {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px dotted currentColor;
	}
	.tag-list a:hover {
		color: var(--link);
		border-bottom-color: var(--link);
	}
</style>
