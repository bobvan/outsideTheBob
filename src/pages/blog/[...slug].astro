---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import TagList from "../../components/TagList.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const includeDrafts = import.meta.env.DEV;

const slugParam = Astro.params.slug ?? "";
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;

const posts = await getCollection("blog", (post) => includeDrafts || !post.data.draft);
const postSlug = (post: BlogEntry) => post.data.slug ?? post.id;

const entry = posts.find((post) => postSlug(post) === slug);
if (!entry) return Astro.redirect("/");

const { Content, headings } = await render(entry);

// See the topic template: the anchor is validated so a jump link cannot rot into
// a scroll to the top of the page.
const bottomLine = entry.data.bottomLine;
if (bottomLine && !headings.some((h) => h.slug === bottomLine)) {
	throw new Error(
		`${entry.id}: bottomLine "${bottomLine}" matches no heading. Headings are: ` +
			headings.map((h) => h.slug).join(', '),
	);
}

const newerToOlder = [...posts].sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const idx = newerToOlder.findIndex((p) => p.id === entry.id);
const prev = newerToOlder[idx - 1];
const next = newerToOlder[idx + 1];

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV;
  const posts = await getCollection("blog", (post) => includeDrafts || !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
  }));
}
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="post-meta">
      <FormattedDate date={entry.data.pubDate} />
      {entry.data.updatedDate && <> · updated <FormattedDate date={entry.data.updatedDate} /></>}
      <TagList tags={entry.data.tags} />
    </p>
    {bottomLine && (
      <p class="bottom-line-jump">
        <a href={`#${bottomLine}`}>Skip the details — take me to the bottom line ↓</a>
      </p>
    )}

    <Content />
    <p>
      {prev && <a href={`/blog/${postSlug(prev)}/`}>← {prev.data.title}</a>}
      {" "}
      {next && <a href={`/blog/${postSlug(next)}/`} style="float:right">{next.data.title} →</a>}
    </p>
  </article>
</BaseLayout>

<style>
  /* A still from a talk recording, linked to the recording. Not a ZoomableImage:
     the click has somewhere better to go than a bigger copy of itself. */
  :global(.video-still) { margin: 1.5rem 0; }
  :global(.video-still img) { display: block; width: 100%; height: auto; border-radius: 0.5rem; }
  :global(.video-still figcaption) { margin-top: 0.4rem; font-size: 0.9rem; color: var(--muted, #666); }

  .bottom-line-jump { margin: -0.4rem 0 1.4rem; font-size: 0.9rem; }
</style>
