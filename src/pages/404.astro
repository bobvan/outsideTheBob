---
// Astro builds this to dist/404.html. Cloudflare only serves it for unmatched
// paths because wrangler.jsonc sets assets.not_found_handling to "404-page" —
// without that the Worker returns its own bare 404 and this file is never seen.
//
// The mark is the site logo run through the same generator with different words
// (npm run banner:404), so the joke is reused rather than a second one invented:
// "404" sits in the box, and "OutsideTheSite" is where you have ended up.
//
// It goes in the header slot rather than the body, replacing the usual banner.
// Showing both put two nearly identical boxes on one page, which read as a
// mistake rather than an echo — and the header is where the eye already looks
// for the mark.
import BaseLayout from "../layouts/BaseLayout.astro";
import notFoundSvg from "../../public/images/outsideTheSite.svg?raw";
---

<BaseLayout
	title="404"
	description="That page is not here — you have gone outside the site."
	banner={notFoundSvg}
>
	<h1>You have gone outside the site.</h1>

	<p>
		There is nothing at this address. Either the link was wrong, or something
		here moved and I did not leave a forwarding note.
	</p>

	<p>
		Try <a href="/blog">the blog</a>, or the <a href="/archive">archive</a> if
		you are looking for something specific and know roughly when it was
		written.{" "}<a href="/tags">Tags</a> are the other way in.
	</p>
</BaseLayout>

<style>
	h1 {
		margin-top: 0;
		font-size: 1.5rem;
	}
</style>
