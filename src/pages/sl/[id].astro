---
// A short link. Static site, so the redirect is a meta refresh rather than a
// 301 — there is no server here to issue a status code, and Cloudflare serves
// these as plain assets.
//
// Deliberately not wrapped in BaseLayout. Nobody is meant to read this page;
// loading the nav, the fonts and the theme script before bouncing would put a
// visible flash in front of somebody who just scanned a code in a meeting.
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const links = await getCollection('shortLinks');
	return links.map((l) => ({ params: { id: l.id }, props: { to: l.data.to } }));
}

const { to } = Astro.props;
const absolute = new URL(to, Astro.site ?? 'https://thinkoutsidethebob.com').href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* noindex so short links never compete with the page they point at. `follow`
		    so the link equity still flows through to the target. */}
		<meta name="robots" content="noindex, follow" />
		<meta http-equiv="refresh" content={`0; url=${to}`} />
		<link rel="canonical" href={absolute} />
		<title>Redirecting…</title>
		<style>
			body {
				font-family: system-ui, sans-serif;
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 1.5rem;
				text-align: center;
				line-height: 1.6;
			}
			a { color: inherit; }
		</style>
	</head>
	<body>
		{/* The visible fallback matters more than it looks. A meta refresh can be
		    disabled, and the reader who lands here got here from a QR code in a
		    room, with no way to type the address by hand. */}
		<p>
			Taking you to <a href={to}>{to}</a>…
			<br />
			<small>If nothing happens, tap the link.</small>
		</p>
	</body>
</html>
