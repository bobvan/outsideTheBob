---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** An imported image, e.g. `import shot from "../../assets/shot.png"`.
	    It must be imported rather than a /public path, because only images
	    Astro can see at build time get resized.

	    A plain string is also accepted, for the generated SVGs in
	    `public/figures/`. Those need no resizing — the browser scales them —
	    so they are emitted as an ordinary <img> and zoom to themselves. */
	src: ImageMetadata | string;
	alt: string;
	/** Width of the inline thumbnail that Astro generates. The zoomed view
	    always shows the original at full resolution. Ignored for string src. */
	width?: number;
	/** When given, the image is wrapped in a figure with this caption.
	    Rendered as HTML, so a caption may contain a link. */
	caption?: string;
	/** Overrides what the zoomed view shows. Use it to open a vector original
	    behind a raster thumbnail. */
	zoomSrc?: string;
	/** Line-art diagrams authored on white get the light plate from BaseLayout
	    in both themes, rather than being blown out in dark mode. */
	plate?: boolean;
}

const { src, alt, width = 720, caption, zoomSrc, plate = false } = Astro.props;

const isPath = typeof src === 'string';
const zoomHref = zoomSrc ?? (isPath ? src : src.src);

// Each instance needs its own id so several zoomable images can share a page.
const id = `zoom-${crypto.randomUUID()}`;
const figureClass = plate ? 'zoom-figure diagram' : 'zoom-figure';
---

{
	caption ? (
		<figure class={figureClass}>
			<button type="button" class="zoom-thumb" popovertarget={id} aria-label={`Enlarge: ${alt}`}>
				{isPath ? <img src={src} alt={alt} loading="lazy" /> : <Image src={src} alt={alt} width={width} loading="lazy" />}
			</button>
			<figcaption set:html={caption} />
		</figure>
	) : (
		<button type="button" class="zoom-thumb" popovertarget={id} aria-label={`Enlarge: ${alt}`}>
			{isPath ? <img src={src} alt={alt} loading="lazy" /> : <Image src={src} alt={alt} width={width} loading="lazy" />}
		</button>
	)
}

<div id={id} popover class:list={['zoom-overlay', { vector: zoomHref.endsWith('.svg') }]}>
	{/* A button rather than a bare <img>: popover light-dismiss only fires for
	    clicks *outside* the popover, and this one covers the viewport, so a
	    click on the picture — the obvious thing to do when the cursor is
	    already zoom-out — did nothing at all. popovertargetaction="hide" closes
	    it declaratively, with no JavaScript and no second Esc-only path. */}
	<button type="button" class="zoom-close" popovertarget={id} popovertargetaction="hide" aria-label="Close enlarged view">
		<img src={zoomHref} alt={alt} />
	</button>
</div>

<style>
	.zoom-figure {
		margin: 1.5rem 0;
	}
	.zoom-figure figcaption {
		margin-top: 0.4rem;
		font-size: 0.9rem;
		color: var(--muted, #666);
		text-align: center;
	}
	/* The plate variant inherits figure.diagram from BaseLayout, which styles
	   its caption as an inset rule rather than centered small print. */
	.zoom-figure.diagram figcaption {
		text-align: left;
	}

	/* The thumbnail is a button so it is keyboard focusable and announces
	   itself, but it should look like a plain image. */
	.zoom-thumb {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: -webkit-zoom-in;
		cursor: zoom-in;
	}
	/* Repeated on the image itself rather than left to inherit: BaseLayout's
	   :global(figure.diagram img) rule reaches inside this component, and a
	   cursor set on an ancestor button is easy to lose to any rule that touches
	   the child. Stating it here is one declaration and removes the question. */
	.zoom-thumb img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		cursor: -webkit-zoom-in;
		cursor: zoom-in;
	}
	.zoom-figure.diagram .zoom-thumb img {
		border-radius: 0;
	}
	.zoom-thumb:focus-visible {
		outline: 2px solid var(--link, #0b5fff);
		outline-offset: 3px;
	}

	/* popover puts this in the browser's top layer, so it needs no z-index and
	   closes on Esc or an outside click without any JavaScript. */
	.zoom-overlay {
		max-width: 96vw;
		max-height: 96vh;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		overflow: auto;
		background: #fff;
		cursor: -webkit-zoom-out;
		cursor: zoom-out;
	}
	.zoom-overlay::backdrop {
		background: rgb(0 0 0 / 0.8);
	}
	.zoom-close {
		display: block;
		padding: 0;
		border: 0;
		background: none;
		cursor: -webkit-zoom-out;
		cursor: zoom-out;
	}
	/* Shown at natural size, not scaled to fit: the point of zooming is to read
	   small type, so overflow scrolls rather than shrinking the image again. */
	.zoom-overlay img {
		display: block;
		max-width: none;
		cursor: -webkit-zoom-out;
		cursor: zoom-out;
	}
	/* A vector has no natural size worth respecting — its viewBox is whatever
	   the generator chose, often smaller than the thumbnail. Fill the viewport
	   instead, which is the whole reason to zoom into one. */
	.zoom-overlay.vector {
		width: 96vw;
		max-height: 96vh;
	}
	.zoom-overlay.vector .zoom-close,
	.zoom-overlay.vector img {
		width: 100%;
		height: auto;
		max-width: 100%;
	}
</style>
