---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const slugParam = Astro.params.slug ?? "";
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;

const posts = await getCollection("blog", (p) => !p.data.draft);
const postSlug = (post: BlogEntry) => post.data.slug ?? post.id;

const entry = posts.find((post) => postSlug(post) === slug);
if (!entry) return Astro.redirect("/");

const { Content } = await render(entry);

const newerToOlder = [...posts].sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const idx = newerToOlder.findIndex((p) => p.id === entry.id);
const prev = newerToOlder[idx - 1];
const next = newerToOlder[idx + 1];

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
  }));
}
---

<BaseLayout title={entry.data.title}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="post-meta">
      {new Date(entry.data.pubDate).toLocaleDateString()}
      {entry.data.tags?.length ? ` • ${entry.data.tags.join(", ")}` : ""}
    </p>
    <Content />
    <p>
      {prev && <a href={`/blog/${postSlug(prev)}/`}>← {prev.data.title}</a>}
      {" "}
      {next && <a href={`/blog/${postSlug(next)}/`} style="float:right">{next.data.title} →</a>}
    </p>
  </article>
</BaseLayout>
