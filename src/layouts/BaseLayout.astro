---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
// Inlined rather than loaded through <img> so the mark shares this document and
// can read `color` and `--banner-halo` from the theme below. An <img>-referenced
// SVG is a separate document: it sees none of the page's CSS, and browsers do
// not agree on whether prefers-color-scheme inside it follows the page or the OS
// (Safari's answer is the reason the logo stayed dark-on-dark).
import bannerSvg from "../../public/images/outsideTheBob.svg?raw";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  frontmatter?: { title?: string; description?: string };
}

const { title, description, image = "/images/og-banner.png", frontmatter } = Astro.props;

// Markdown and MDX pages that set `layout:` hand their frontmatter over as one
// `frontmatter` prop rather than as individual props, so accept either shape.
const resolvedTitle = title ?? frontmatter?.title;
const resolvedDescription = description ?? frontmatter?.description ?? SITE_DESCRIPTION;

// Pages pass their own name ("Home", a post title); the site name is appended
// so a bare browser tab or a shared link still says whose blog this is.
const pageTitle = resolvedTitle ? `${resolvedTitle} · ${SITE_TITLE}` : SITE_TITLE;

// Astro.site comes from `site:` in astro.config.mjs. Both are absolute, which
// is what canonical and og: tags require.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <style>
      :root {
        color-scheme: light dark;
        --text:#111; --muted:#666; --link:#0b5fff; --bg:#fff; --border:#e6e6e6;
        --surface:#fafafa; --code-bg:#f1f2f4; --table-border:#c2c6cc;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --text:#e7e8ea; --muted:#9b9ca4; --link:#7fb2ff; --bg:#16171b; --border:#2d2f36;
          --surface:#1c1d22; --code-bg:#24262d; --table-border:#474a53;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color: var(--text); background: var(--bg); }
      header, footer { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--surface); }
      header .wrap, main .wrap, footer .wrap { max-width: 820px; margin: 0 auto; padding: 1rem; }
      /* Astro compresses whitespace between elements, so gaps between inline
         links have to come from CSS rather than from source newlines. */
      nav a { margin-right: 1rem; text-decoration: none; color: var(--link); }
      nav a:hover { text-decoration: underline; }
      nav .sep { margin-right: 1rem; }
      /* The banner is inlined SVG, so its ink is currentColor and follows this.
         The halo behind the wordmark is a separate problem: it is there to punch
         a hole through the box wall, so it has to match what is actually behind
         the mark — the header's --surface, not the page --bg. The SVG ships a
         literal white fallback for standalone use; this rule overrides it.
         The SVG arrives through set:html, so it carries no scope attribute and
         anything below `.banner` has to be :global() to match at all. */
      .banner { display: block; margin: 0 0 0.5rem; color: var(--text); }
      .banner :global(svg) { display: block; width: 100%; max-width: 620px; height: auto; }
      .banner :global(.wordmark) { stroke: var(--surface); }
      footer a { margin-right: 1rem; }
      h1,h2,h3 { line-height:1.25; }
      article { padding: 1rem 0; border-bottom: 1px solid var(--border); }
      .post-meta { color: var(--muted); font-size: 0.9rem; margin-top: -0.5rem; }
      .archive-month { margin-top: 2rem; }
      .list-unstyled { list-style: none; padding-left: 0; }
      .muted { color: var(--muted); }
      footer { font-size: 0.9rem; }

      /* Everything below targets either slotted Markdown or elements the copy
         script creates at runtime. Neither carries this component's scope
         attribute, so these selectors have to be :global() or they silently
         match nothing. */

      /* Inline code: a tint and a little padding so a path or a filename reads
         as a distinct object in a sentence rather than just a font change. The
         :not(pre) guard keeps this off the code inside fenced blocks, which
         Shiki has already coloured. */
      :global(:not(pre) > code) {
        background: var(--code-bg);
        padding: 0.12em 0.38em;
        border-radius: 0.25rem;
        font-size: 0.9em;
      }

      /* Markdown tables arrive with no styling at all, so they read as drifting
         columns of text. Collapsed borders on every cell give them edges and a
         shaded header band separates the labels from the data.
         --table-border rather than --border: the latter is tuned for large quiet
         edges like the header rule, and at cell scale it is too faint to read as
         a grid. A table needs its lines actually visible. */
      :global(.wrap table) {
        width: 100%;
        margin: 1.25rem 0;
        border-collapse: collapse;
        font-size: 0.95rem;
      }
      :global(.wrap th),
      :global(.wrap td) {
        padding: 0.45rem 0.7rem;
        border: 1px solid var(--table-border);
        text-align: left;
        vertical-align: top;
      }
      :global(.wrap thead th) {
        background: var(--surface);
        font-weight: 600;
      }
      /* Line-art diagrams. These are authored on white with white-filled boxes
         so the wires don't show through them, and their legend colours are
         chosen against white — so rather than fight that in dark mode, the
         figure keeps its own light plate in both themes and reads as a
         deliberate inset. The plate is what makes it look intentional instead
         of like a blown-out PNG. */
      :global(figure.diagram) {
        margin: 1.5rem 0;
        padding: 1rem;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
      }
      :global(figure.diagram img) {
        display: block;
        width: 100%;
        height: auto;
      }
      :global(figure.diagram figcaption) {
        margin-top: 0.75rem;
        padding-top: 0.6rem;
        border-top: 1px solid #e6e6e6;
        font-size: 0.9rem;
        line-height: 1.45;
        /* Fixed rather than var(--muted): this sits on the light plate above,
           so it must stay dark even when the page around it is dark. */
        color: #555;
      }

      :global(pre.astro-code) {
        padding: 0.9rem 1rem;
        border-radius: 0.4rem;
        border: 1px solid var(--border);
      }

      /* Shiki wrote both palettes into the markup; this picks the dark one.
         !important is required because the light values are inline styles. */
      @media (prefers-color-scheme: dark) {
        :global(pre.astro-code),
        :global(pre.astro-code span) {
          color: var(--shiki-dark) !important;
          background-color: var(--shiki-dark-bg) !important;
          font-style: var(--shiki-dark-font-style) !important;
          font-weight: var(--shiki-dark-font-weight) !important;
          text-decoration: var(--shiki-dark-text-decoration) !important;
        }
      }

      /* Copy button, injected by the script below. Visible but quiet, and
         fully opaque on hover or keyboard focus. Always rendered rather than
         hover-only, since a touch device has no hover. */
      :global(.code-wrap) { position: relative; }
      :global(.code-wrap .copy-code) {
        position: absolute;
        top: 0.45rem;
        right: 0.45rem;
        padding: 0.2rem 0.5rem;
        font: inherit;
        font-size: 0.78rem;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 0.25rem;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.15s ease;
      }
      :global(.code-wrap:hover .copy-code),
      :global(.code-wrap .copy-code:focus-visible) { opacity: 1; }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a class="banner" href="/" aria-label={SITE_TITLE} set:html={bannerSvg} />
        <nav>
          <a href="/">Home</a>
          <a href="/blog">Blog</a>
          <a href="/archive">Archive</a>
          <a href="/tags">Tags</a>
          <a href="/about">About</a>
          <span class="sep muted">|</span>
          <a href="https://github.com/bobvan" rel="me">GitHub</a>
          <a href="https://www.linkedin.com/in/bobvan" rel="me">LinkedIn</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>

    <script>
      // Progressive enhancement: no button exists unless this runs, so a
      // reader without JavaScript simply selects the code as before.
      for (const pre of document.querySelectorAll('pre.astro-code')) {
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-code';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        wrap.appendChild(button);

        button.addEventListener('click', async () => {
          const text = pre.innerText;
          let copied = false;

          // navigator.clipboard only exists in a secure context, so it is
          // unavailable over plain http - which is exactly how the dev server
          // is reached from another machine on the LAN.
          if (navigator.clipboard && window.isSecureContext) {
            try {
              await navigator.clipboard.writeText(text);
              copied = true;
            } catch {
              // fall through to the textarea path
            }
          }

          if (!copied) {
            const scratch = document.createElement('textarea');
            scratch.value = text;
            scratch.setAttribute('readonly', '');
            scratch.style.position = 'fixed';
            scratch.style.opacity = '0';
            document.body.appendChild(scratch);
            scratch.select();
            try {
              copied = document.execCommand('copy');
            } catch {
              copied = false;
            }
            document.body.removeChild(scratch);
          }

          button.textContent = copied ? 'Copied' : 'Copy failed';
          setTimeout(() => {
            button.textContent = 'Copy';
          }, 1600);
        });
      }
    </script>
  </body>
</html>
