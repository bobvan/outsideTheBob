---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagList from '../../components/TagList.astro';
import { tagIndex, hasOwnPage, postSlug, type Tag } from '../../tags';

// One page per tag that groups more than one post. Single-post tags link
// straight to their post from everywhere, so a page here would be unreachable -
// and a page nothing links to, still listed in the sitemap, is worse than no
// page at all. The posts travel as props, so each page is built from the index
// that already grouped them rather than re-querying the collection.
export async function getStaticPaths() {
	const tags = await tagIndex();
	return tags.filter(hasOwnPage).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

interface Props {
	tag: Tag;
}

const { tag } = Astro.props;
const count = tag.posts.length;
---

<BaseLayout
	title={`Tagged ${tag.label}`}
	description={`${count} post${count === 1 ? '' : 's'} tagged ${tag.label} on Think Outside The Bob.`}
>
	<h1>Tagged “{tag.label}”</h1>
	<p class="muted">
		{count} post{count === 1 ? '' : 's'} · <a href="/tags/">all tags</a>
	</p>

	{
		tag.posts.map((post) => (
			<article>
				<h2>
					<a href={`/blog/${postSlug(post)}/`}>{post.data.title}</a>
				</h2>
				<p class="post-meta">
					<FormattedDate date={post.data.pubDate} />
					<TagList tags={post.data.tags} />
				</p>
				{post.data.description && <p>{post.data.description}</p>}
			</article>
		))
	}
</BaseLayout>
