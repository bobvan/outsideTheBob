---
import type { ImageMetadata } from 'astro';
import ZoomableImage from './ZoomableImage.astro';

interface Props {
  /** Preferred: an imported image. Astro resizes it at build time and the
      reader gets a click-to-zoom view of the original. */
  img?: ImageMetadata;
  /** Fallback for images that live in /public and so cannot be resized. */
  imgSrc?: string;
  imgAlt: string;
  side?: 'left' | 'right';
  caption?: string;
}

const { img, imgSrc, imgAlt, side = 'right', caption } = Astro.props;
---

<style>
.wrapper {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  margin: 1.5rem 0;
  gap: 1rem;
}
.media {
  max-width: 45%;
  min-width: 200px;
}
.media img {
  width: 100%;
  height: auto;
  border-radius: 0.5rem;
}
.text {
  flex: 1;
  min-width: 250px;
}
.right .media { order: 2; }
.left .media { order: 0; }
.caption {
  font-size: 0.9rem;
  color: var(--color-text-muted, #666);
  text-align: center;
  margin-top: 0.25rem;
}
</style>

<div class:list={`wrapper ${side}`}>
  <div class="media">
    {
      img ? (
        <ZoomableImage src={img} alt={imgAlt} />
      ) : (
        <img src={imgSrc} alt={imgAlt} loading="lazy" />
      )
    }
  </div>
  <div class="text">
    <slot />
    {caption && <p class="caption">{caption}</p>}
  </div>
</div>
